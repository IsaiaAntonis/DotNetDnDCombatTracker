<Window x:Class="DndTracker.EnemyInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DndTracker"
        mc:Ignorable="d"
        Title="Enemy Information" Height="600" Width="500">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Enemy Name -->
        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>


<!-- Basic Stats -->
<StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
    <Image Source="{Binding ImagePath}" Width="100" Height="100" Margin="0,0,10,0"/>
    <StackPanel VerticalAlignment="Center">
        <TextBlock>
            <Run Text="AC: "/>
            <Run Text="{Binding AC}"/>
        </TextBlock>
        <TextBlock>
            <Run Text="HP: "/>
            <Run Text="{Binding HP}"/>
        </TextBlock>
        <TextBlock>
            <Run Text="Initiative: "/>
            <Run Text="{Binding Initiative}"/>
        </TextBlock>
    </StackPanel>
</StackPanel>

        <!-- Ability Scores + Abilities -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ability Scores" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>
            <!-- Ability Scores -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="3" Margin="0,0,0,10">
                <TextBlock>
        <Run Text="STR: "/>
        <Run Text="{Binding STR}"/>
                </TextBlock>
                <TextBlock>
        <Run Text="DEX: "/>
        <Run Text="{Binding DEX}"/>
                </TextBlock>
                <TextBlock>
        <Run Text="CON: "/>
        <Run Text="{Binding CON}"/>
                </TextBlock>
                <TextBlock>
        <Run Text="INT: "/>
        <Run Text="{Binding INT}"/>
                </TextBlock>
                <TextBlock>
        <Run Text="WIS: "/>
        <Run Text="{Binding WIS}"/>
                </TextBlock>
                <TextBlock>
        <Run Text="CHA: "/>
        <Run Text="{Binding CHA}"/>
                </TextBlock>
            </UniformGrid>
            <!-- Notes -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Notes:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Optional: Hit Dice -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Hit Dice:" FontWeight="Bold"/>
                <TextBlock>
        <Run Text="{Binding HitDiceAmount}"/>
        <Run Text="d"/>
        <Run Text="{Binding HitDiceSize}"/>
        <Run Text="+"/>
        <Run Text="{Binding HitDiceFlatModifier}"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
