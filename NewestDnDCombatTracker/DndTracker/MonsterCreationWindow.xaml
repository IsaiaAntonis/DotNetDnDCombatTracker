<Window x:Class="DndTracker.MonsterCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Monster" Height="750" Width="500">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" VerticalAlignment="Top">

            <!-- Name -->
            <TextBlock Text="Monster Name:" FontWeight="Bold" />
            <TextBox x:Name="textBoxName" Width="300" Margin="0,5,0,10"/>

            <!-- Image Path -->
            <TextBlock Text="Image Path:" FontWeight="Bold" />
            <TextBox x:Name="textBoxImagePath" Text="Images/yourimage.jpg" Width="300" Margin="0,5,0,10"/>

            <!-- Basic Stats -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Left">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="AC:" FontWeight="Bold"/>
                    <TextBox x:Name="textBoxAC" Width="60"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="HP:" FontWeight="Bold"/>
                    <TextBox x:Name="textBoxHP" Width="60"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Initiative:" FontWeight="Bold"/>
                    <TextBox x:Name="textBoxInitiative" Width="60"/>
                </StackPanel>
            </StackPanel>

            <!-- Ability Scores -->
            <GroupBox Header="Ability Scores" Margin="0,0,0,10">
                <UniformGrid Columns="2" Rows="3" Margin="10">
                    <StackPanel>
                        <TextBlock Text="STR:"/>
                        <TextBox x:Name="textBoxSTR" Width="60"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DEX:"/>
                        <TextBox x:Name="textBoxDEX" Width="60"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CON:"/>
                        <TextBox x:Name="textBoxCON" Width="60"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="INT:"/>
                        <TextBox x:Name="textBoxINT" Width="60"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="WIS:"/>
                        <TextBox x:Name="textBoxWIS" Width="60"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CHA:"/>
                        <TextBox x:Name="textBoxCHA" Width="60"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <!-- Hit Dice -->
            <TextBlock Text="Hit Dice:" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <TextBox x:Name="textBoxHitDiceAmount" Width="40" Margin="0,0,5,0"/>
                <TextBlock Text="d" VerticalAlignment="Center"/>
                <TextBox x:Name="textBoxHitDiceSize" Width="40" Margin="5,0,5,0"/>
                <TextBlock Text="+" VerticalAlignment="Center"/>
                <TextBox x:Name="textBoxHitDiceFlatModifier" Width="40" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- Notes -->
            <TextBlock Text="Notes:" FontWeight="Bold"/>
            <TextBox x:Name="textBoxNotes" TextWrapping="Wrap" AcceptsReturn="True" Height="100" Margin="0,5,0,10"/>

            <!-- Combo Box for Player/Enemy -->
            <TextBlock Text="Entity Type:" FontWeight="Bold"/>
            <ComboBox x:Name="comboBox" Width="120" Height="30" Margin="0,5,0,20">
                <ComboBoxItem Content="Player"/>
                <ComboBoxItem Content="Enemy"/>
            </ComboBox>

            <ComboBox x:Name="comboBoxWeapon" Width="200" Height="30" Margin="0,5,0,20">
                <ComboBoxItem Content="None"/>

                <!-- Simple Melee Weapons -->
                <ComboBoxItem Content="Club"/>
                <ComboBoxItem Content="Dagger"/>
                <ComboBoxItem Content="Greatclub"/>
                <ComboBoxItem Content="Handaxe"/>
                <ComboBoxItem Content="Javelin"/>
                <ComboBoxItem Content="Light Hammer"/>
                <ComboBoxItem Content="Mace"/>
                <ComboBoxItem Content="Quarterstaff"/>
                <ComboBoxItem Content="Sickle"/>
                <ComboBoxItem Content="Spear"/>

                <!-- Simple Ranged Weapons -->
                <ComboBoxItem Content="Light Crossbow"/>
                <ComboBoxItem Content="Dart"/>
                <ComboBoxItem Content="Shortbow"/>
                <ComboBoxItem Content="Sling"/>

                <!-- Martial Melee Weapons -->
                <ComboBoxItem Content="Battleaxe"/>
                <ComboBoxItem Content="Flail"/>
                <ComboBoxItem Content="Glaive"/>
                <ComboBoxItem Content="Greataxe"/>
                <ComboBoxItem Content="Greatsword"/>
                <ComboBoxItem Content="Halberd"/>
                <ComboBoxItem Content="Lance"/>
                <ComboBoxItem Content="Longsword"/>
                <ComboBoxItem Content="Maul"/>
                <ComboBoxItem Content="Morningstar"/>
                <ComboBoxItem Content="Pike"/>
                <ComboBoxItem Content="Rapier"/>
                <ComboBoxItem Content="Scimitar"/>
                <ComboBoxItem Content="Shortsword"/>
                <ComboBoxItem Content="Trident"/>
                <ComboBoxItem Content="War Pick"/>
                <ComboBoxItem Content="Warhammer"/>
                <ComboBoxItem Content="Whip"/>

                <!-- Martial Ranged Weapons -->
                <ComboBoxItem Content="Blowgun"/>
                <ComboBoxItem Content="Hand Crossbow"/>
                <ComboBoxItem Content="Heavy Crossbow"/>
                <ComboBoxItem Content="Longbow"/>
                <ComboBoxItem Content="Net"/>
            </ComboBox>


            <ComboBox x:Name="comboBoxFinesse" Text="Finesse or not" Width="120" Height="30" Margin="0,5,0,20">
                <ComboBoxItem Content="Finesse Yes"/>
                <ComboBoxItem Content="Finesse No"/>
            </ComboBox>
            <!-- Save Button -->
            <Button Content="Save Monster" Width="150" Height="40" Click="Button_Click" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</Window>
