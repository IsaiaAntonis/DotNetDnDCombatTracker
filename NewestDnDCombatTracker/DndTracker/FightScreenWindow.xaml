<Window x:Class="DndTracker.FightScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DndTracker"
        mc:Ignorable="d"
        Title="FightScreenWindow" Height="450" Width="776">
    <Grid Margin="0,0,643,0">
        <Canvas Name="paperCanvas" Background="LightGray" Grid.ColumnSpan="2"/>
        <Button x:Name="button" Background="Orange" Content="Next turn" Margin="572,346,-590,42" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.237"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0.312"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <ListBox x:Name="listBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="314,90,-314,-90"/>
    </Grid>
</Window>
