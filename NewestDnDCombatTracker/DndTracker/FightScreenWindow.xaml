<Window x:Class="DndTracker.FightScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DndTracker"
        mc:Ignorable="d"
        Title="FightScreenWindow" Height="450" Width="776">



    <Grid Margin="0,0,0,0">
        <Canvas Name="paperCanvas" Background="LightGray" Grid.ColumnSpan="2">
            <Button x:Name="buttonAttack" Content="Attack" Canvas.Left="699" Canvas.Top="63" Click="buttonAttack_Click" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Button x:Name="buttonHeal" Content="Heal" Canvas.Left="699" Canvas.Top="127" Click="buttonHeal_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="38" RenderTransformOrigin="0.492,1.162"/>
            <TextBox x:Name="textBoxCustomAttack" Canvas.Left="689" TextWrapping="Wrap" Text="" Canvas.Top="88" Width="58" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="textBoxCustomHeal" Canvas.Left="689" TextWrapping="Wrap" Text="" Canvas.Top="152" Width="58" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Label x:Name="labelDamage" Content=""
       Canvas.Left="464" Canvas.Top="304"
       HorizontalAlignment="Left"
       VerticalAlignment="Center"/>
        </Canvas>

        <Grid Margin="100,0,290,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Enemy Name -->
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>


            <!-- Basic Stats -->
            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
                <Image Source="{Binding ImagePath}" Width="100" Height="100" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock>
            <Run Text="AC: "/>
            <Run Text="{Binding AC}"/>
                    </TextBlock>
                    <TextBlock>
            <Run Text="HP: "/>
            <Run Text="{Binding HP}"/>
                    </TextBlock>
                    <TextBlock>
            <Run Text="Initiative: "/>
            <Run Text="{Binding Initiative}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Ability Scores + Abilities -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ability Scores" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>
                <!-- Ability Scores -->
                <UniformGrid Grid.Row="1" Columns="2" Rows="3" Margin="0,0,0,10">
                    <TextBlock>
        <Run Text="STR: "/>
        <Run Text="{Binding STR}"/>
                    </TextBlock>
                    <TextBlock>
        <Run Text="DEX: "/>
        <Run Text="{Binding DEX}"/>
                    </TextBlock>
                    <TextBlock>
        <Run Text="CON: "/>
        <Run Text="{Binding CON}"/>
                    </TextBlock>
                    <TextBlock>
        <Run Text="INT: "/>
        <Run Text="{Binding INT}"/>
                    </TextBlock>
                    <TextBlock>
        <Run Text="WIS: "/>
        <Run Text="{Binding WIS}"/>
                    </TextBlock>
                    <TextBlock>
        <Run Text="CHA: "/>
        <Run Text="{Binding CHA}"/>
                    </TextBlock>
                </UniformGrid>
                <!-- Notes -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Notes:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Optional: Hit Dice -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="Hit Dice:" FontWeight="Bold"/>
                    <TextBlock>
        <Run Text="{Binding HitDiceAmount}"/>
        <Run Text="d"/>
        <Run Text="{Binding HitDiceSize}"/>
        <Run Text="+"/>
        <Run Text="{Binding HitDiceFlatModifier}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>

        <Button x:Name="button" Background="Orange" Content="Next turn" Margin="560,350,57,37"  Click="button_Click"></Button>
        <ListBox x:Name="listBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="461,59,124,155" ></ListBox>
    </Grid>



</Window>
