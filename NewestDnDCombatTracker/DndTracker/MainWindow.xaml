<Window x:Class="DndTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DndTracker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="151*"/>
            <ColumnDefinition Width="649*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="buttonCreateEncounter" Grid.Column="2" Content="Encounter Creation" HorizontalAlignment="Left" Margin="99,133,0,0" VerticalAlignment="Top" Click="button_Click"/>
        <Button x:Name="buttonCreateMonsters" Grid.Column="2" Content="Monster Creation" HorizontalAlignment="Left" Margin="260,133,0,0" VerticalAlignment="Top" Click="button_Click"/>

    </Grid>
</Window>
