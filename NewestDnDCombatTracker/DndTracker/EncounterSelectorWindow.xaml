<Window x:Class="DndTracker.EncounterSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DndTracker"
        mc:Ignorable="d"
        Title="EncounterSelectorWindow" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="listBox" Grid.Column="2" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="154,165,344,28" />
        <TextBox x:Name="AmountOfEnemiesTextBox" HorizontalAlignment="Left" Margin="257,101,0,0" TextWrapping="Wrap" Text="5" VerticalAlignment="Top" Width="20"/>
        <Button x:Name="button" Content="Button" HorizontalAlignment="Left" Margin="189,99,0,0" VerticalAlignment="Top" Click="button_Click"/>
        <Button x:Name="buttonStart" Content="StartTurnBased" HorizontalAlignment="Left" Margin="657,331,0,0" VerticalAlignment="Top" Click="buttonStartTurnBased_Click"/>
        <Button x:Name="buttonStartInteractive" Content="StartInteractive" HorizontalAlignment="Left" Margin="657,245,0,0" VerticalAlignment="Top" Click="buttonStartInteractive_Click"/>
        <ComboBox Name="combox" Margin="337,99,323,287" SelectedIndex="0">

        </ComboBox>

    </Grid>
</Window>
